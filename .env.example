# Vite exposes VITE_* variables to browser code. Do not put secrets here.
# Browser requests use the same-origin Vite proxy during local development.
VITE_API_BASE_URL=/api
# Server-only Vite setting; unlike VITE_* values, this is not exposed to browser code.
API_PROXY_TARGET=http://localhost:8000
VITE_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AWS_REGION=ap-northeast-1
